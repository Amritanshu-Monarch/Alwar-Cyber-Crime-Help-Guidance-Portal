# Get a key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# The agent needs a capable model for tool routing (the lite model mis-routed Hindi questions).
# gemini-3.8-flash was returning 503 (capacity) when tested; 3.7 worked.
AGENT_MODEL=gemini-3.7-flash
STT_MODEL=gemini-3.1-flash-lite
TTS_MODEL=gemini-3.8-flash-tts
TTS_VOICE=Kore
EMBED_MODEL=gemini-embedding-001

ALLOWED_ORIGINS=["http://localhost:5173"]
RATE_LIMIT=30/minute
