# Get a key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Agent model — gemini-3.8-flash is the current stable workhorse (verified 2026-11-16).
# gemini-3.7-flash is NOT in the current model list and should not be used.
AGENT_MODEL=gemini-3.8-flash

# STT model — gemini-3.5-transcribe is the dedicated stable transcription model (verified 2026-11-16).
# gemini-3.1-flash-lite works but is not optimised for multilingual/Hinglish audio.
STT_MODEL=gemini-3.5-transcribe

# TTS model — gemini-3.8-flash-tts is the current stable TTS model (verified 2026-11-16).
TTS_MODEL=gemini-3.8-flash-tts
TTS_VOICE=Kore

EMBED_MODEL=gemini-embedding-001

# Multi-Provider configuration (fallback order: gemini -> sarvam -> groq -> ollama)
LLM_PROVIDER_ORDER=gemini,sarvam,groq,ollama
STT_PROVIDER=gemini
TTS_PROVIDER=gemini

# Sarvam AI (Indian multilingual platform: https://www.sarvam.ai)
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-2b

# Groq (Fast OpenAI-compatible inference: https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Local Ollama (http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

ALLOWED_ORIGINS=["http://localhost:5173"]
RATE_LIMIT=30/minute
